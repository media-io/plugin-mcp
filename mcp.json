{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "media-io-mcp": {
      "type": "streamable-http",
      "url": "https://mcp.media.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mediaio:basic"
            ]
          }
        }
      }
    }
  }
}
